@model List<BordoStock.Models.Warehouse>

@{
    ViewData["Title"] = "Depolar";
}

<div class="page-header">
    <h2>Depo Listesi</h2>
    <a asp-action="Create" class="btn-primary">Yeni Depo</a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Depo Adı</th>
            <th>Adres</th>
            <th>Durum</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Address</td>
                <td>@(item.IsActive ? "Aktif" : "Pasif")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-secondary">Düzenle</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn-danger" onclick="return confirm('Silmek istediğinize emin misiniz?')">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>
