@model BordoStock.Models.Product

@{
    ViewData["Title"] = "Ürün Ekle";
}

<div class="form-container">
    <h2>Yeni Ürün</h2>

    <form asp-action="Create" method="post">
        <div class="form-group">
            <label asp-for="Name"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name"></span>
        </div>

        <div class="form-group">
            <label asp-for="Code"></label>
            <input asp-for="Code" class="form-control" />
            <span asp-validation-for="Code"></span>
        </div>

        <div class="form-group">
            <label asp-for="CategoryId"></label>
            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-control"></select>
        </div>

        <div class="form-group">
            <label asp-for="SupplierId"></label>
            <select asp-for="SupplierId" asp-items="ViewBag.Suppliers" class="form-control"></select>
        </div>

        <div class="form-group">
            <label asp-for="PurchasePrice"></label>
            <input asp-for="PurchasePrice" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="SalePrice"></label>
            <input asp-for="SalePrice" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="StockQuantity"></label>
            <input asp-for="StockQuantity" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="MinStockLevel"></label>
            <input asp-for="MinStockLevel" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>

        <button type="submit" class="btn-primary">Kaydet</button>
    </form>
</div>
