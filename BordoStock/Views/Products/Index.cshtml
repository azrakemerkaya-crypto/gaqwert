@model List<BordoStock.Models.Product>

@{
    ViewData["Title"] = "Ürünler";
}

<div class="page-header">
    <h2>Ürün Listesi</h2>
    <a asp-action="Create" class="btn-primary">Yeni Ürün</a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Kod</th>
            <th>Ürün</th>
            <th>Kategori</th>
            <th>Stok</th>
            <th>Alış Fiyatı</th>
            <th>Satış Fiyatı</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Code</td>
                <td>@item.Name</td>
                <td>@(item.Category?.Name ?? "-")</td>
                <td>@item.StockQuantity</td>
                <td>@item.PurchasePrice.ToString("C")</td>
                <td>@item.SalePrice.ToString("C")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-secondary">Düzenle</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn-danger" onclick="return confirm('Silmek istediğine emin misin?')">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>
